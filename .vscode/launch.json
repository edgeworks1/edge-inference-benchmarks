{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1 train (MLP)",
            "type": "debugpy", "request": "launch",
            "module": "ble_cs_profiling",
            "args": ["train", "-m", "edge_bench_mlp"],
            "cwd": "${workspaceFolder}/ml",
            "console": "integratedTerminal", "justMyCode": true
        },
        {
            "name": "2 export (MLP)",
            "type": "debugpy", "request": "launch",
            "module": "ble_cs_profiling",
            "args": ["export", "checkpoints/edge_bench_mlp.pt", "--no-onnx",
                     "-o", "outputs/debug"],
            "cwd": "${workspaceFolder}/ml",
            "console": "integratedTerminal", "justMyCode": true
        },
        {
            "name": "3 codegen (MLP)",
            "type": "debugpy", "request": "launch",
            "module": "ble_cs_profiling",
            "args": ["codegen", "model", "outputs/debug/edge_bench_mlp/int8_full/model.tflite",
                     "-o", "outputs/debug/fw"],
            "cwd": "${workspaceFolder}/ml",
            "console": "integratedTerminal", "justMyCode": true
        }
    ]
}
