:name: nRF5340 TFLM Profiler
:description: Simulates the nRF5340 M33 with enlarged RAM/flash

$name?="nrf5340dk_nrf5340_cpuapp"
# $ORIGIN = folder of this script -> independent of the current directory (no @, it would be taken literally)
$repl?=$ORIGIN/cortex_m33_profiler.repl
# ELF of the Renode variant (west build -d build/renode -S renode)
$bin?=$ORIGIN/../build/renode/zephyr/zephyr.elf

using sysbus
mach create $name
machine LoadPlatformDescription $repl

# Scale the core performance to 128 MHz
cpu0 PerformanceInMips 128

# Silence sysbus and clock warnings (level 3 = error)
logLevel 3 sysbus
logLevel 3 clock

# Silence the unmodelled peripheral range (0x50015000 - 0x50015FFF)
sysbus SilenceRange <0x50015000 0x1000>

# Route the UART output to the terminal
showAnalyzer uart0 Antmicro.Renode.Analyzers.LoggingUartAnalyzer

# Panic hook: report kernel faults instead of hanging silently
set osPanicHook
"""
self.ErrorLog("OS Panicked / Kernel Fault!")
"""
cpu0 AddSymbolHook "z_fatal_error" $osPanicHook

macro reset
"""
    sysbus LoadELF $bin
    cpu0 VectorTableOffset `sysbus GetSymbolAddress "_vector_table"`
    cpu0 EnableZephyrMode
"""

runMacro $reset

echo "Starting simulation..."
start