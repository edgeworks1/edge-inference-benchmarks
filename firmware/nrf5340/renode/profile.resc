:name: nRF5340 TFLM Profiler
:description: Simuliert nRF5340 M33 mit vergrößertem RAM/Flash

$name?="nrf5340dk_nrf5340_cpuapp"
# $ORIGIN = Ordner dieses Skripts -> unabhängig vom aktuellen Verzeichnis (ohne @, sonst wörtlich)
$repl?=$ORIGIN/cortex_m33_profiler.repl
# ELF der Renode-Variante (west build -d build/renode -S renode)
$bin?=$ORIGIN/../build/renode/zephyr/zephyr.elf

using sysbus
mach create $name
machine LoadPlatformDescription $repl

# Core Performance auf 128 MHz skalieren
cpu0 PerformanceInMips 128

# Sysbus & Clock Warnings stummschalten (Level 3 = Error)
logLevel 3 sysbus
logLevel 3 clock

# Stummschalten des undefinierten Peripherie-Bereichs (0x50015000 - 0x50015FFF)
sysbus SilenceRange <0x50015000 0x1000>

# UART-Ausgabe ins Terminal leiten
showAnalyzer uart0 Antmicro.Renode.Analyzers.LoggingUartAnalyzer

# Panic Hook fängt Abstürze sauber ab
set osPanicHook
"""
self.ErrorLog("OS Panicked / Kernel Fault!")
"""
cpu0 AddSymbolHook "z_fatal_error" $osPanicHook

macro reset
"""
    sysbus LoadELF $bin
    cpu0 VectorTableOffset `sysbus GetSymbolAddress "_vector_table"`
    cpu0 EnableZephyrMode
"""

runMacro $reset

echo "Starte Simulation..."
start