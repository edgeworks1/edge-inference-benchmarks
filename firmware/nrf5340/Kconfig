# Options of this app. Set values in prj.conf, in a snippet or with -D<OPTION>=... at build time.

menu "Edge inference benchmark app"

config APP_TENSOR_ARENA_SIZE
	int "TFLM tensor arena size (bytes)"
	default 131072
	help
	  Static memory for all tensors of the inference (placed in RAM/.bss).
	  Default 128 KiB: fits the real nRF5340 DK (448 KiB RAM for the app).
	  The Renode variant sets more to test models of any size.
	  Actual need: see "Total Arena: used / size" in the UART log.

endmenu

# Must stay at the end: loads all Zephyr options (otherwise Kconfig only knows ours)
source "Kconfig.zephyr"
